<Context>
    <Resource name="jdbc/h2db"
              auth="Container"
              type="javax.sql.DataSource"
              driverClassName="org.h2.Driver"
              url="jdbc:h2:mem:jwtdb;DB_CLOSE_DELAY=-1"
              username="jwtuser"
              password="jwtpassword"
              maxTotal="10"
              maxIdle="5"
              maxWaitMillis="10000"/>
</Context>